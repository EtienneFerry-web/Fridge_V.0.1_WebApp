{% extends 'base.html.twig' %}

{% block title %}{{ liste.listeLibelle }} - Fridge{% endblock %}

{% block body %}

<div class="search-hero mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="display-5 fw-bold mb-1">{{ liste.listeLibelle }}</h1>
                <p class="lead text-muted mb-0">Créée le {{ liste.listeDateCreation|date('d/m/Y') }}</p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_liste_course_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
                <form action="{{ path('app_liste_course_delete', {id: liste.id}) }}" method="POST"
                    data-confirm="Voulez-vous vraiment supprimer cette liste de courses ?"
                    data-confirm-title="Supprimer la liste">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<main class="container mb-5">
    <div class="bento-grid">
        <div class="row g-4">
            <div class="col-lg-12">
                {% if parCategorie is empty %}
                    <div class="text-center py-5">
                        <i class="bi bi-basket2 display-1 text-muted opacity-25 mb-3"></i>
                        <p class="text-muted">Cette liste est vide.</p>
                    </div>
                {% else %}
                    {% for categorie, elements in parCategorie %}
                        <div class="mb-5">
                            <h3 class="h4 fw-bold mb-4" style="font-family: var(--font-display); color: var(--text-secondary);">
                                <i class="bi bi-tag text-primary me-2"></i>{{ categorie }}
                            </h3>
                            <div class="list-group list-group-flush rounded-4 overflow-hidden border">
                                {% for item in elements %}
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-bottom bg-transparent">
                                        <div class="d-flex align-items-center flex-grow-1">
                                            <div class="form-check me-3">
                                                <input class="form-check-input ms-0 check-ingredient" type="checkbox" 
                                                       data-id="{{ item.id }}"
                                                       id="check-{{ item.id }}"
                                                       {{ item.contenirEstCoche ? 'checked' : '' }}
                                                       style="width: 1.5rem; height: 1.5rem; cursor: pointer;">
                                            </div>
                                            <label class="form-check-label mb-0 {{ item.contenirEstCoche ? 'text-decoration-line-through opacity-50' : 'fw-bold' }}"
                                                   for="check-{{ item.id }}" style="cursor: pointer; font-size: 1.1rem;">
                                                {{ item.ingredient ? item.ingredient.ingredientLibelle : item.contenirLibelleBrut }}
                                            </label>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge rounded-pill px-3 py-2 shadow-sm" style="background-color: var(--primary); color: var(--text); font-size: 0.9rem;">
                                                {{ item.contenirQuantite }} {{ item.contenirUnite }}
                                            </span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
    <div class="container mb-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3" style="font-family: var(--font-display);">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Ajouter un article manuellement
                </h5>
                <form id="form-ajout-manuel" class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label small fw-semibold" for="manuel-libelle">Article</label>
                        <input type="text" id="manuel-libelle" class="form-control" placeholder="Ex : huile d'olive, sel…" required>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold" for="manuel-quantite">Quantité</label>
                        <input type="number" id="manuel-quantite" class="form-control" placeholder="Ex : 2" min="0" step="any">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold" for="manuel-unite">Unité</label>
                        <select id="manuel-unite" class="form-select">
                            <option value="">—</option>
                            <option value="pièce">pièce</option>
                            <option value="g">g</option>
                            <option value="kg">kg</option>
                            <option value="mL">mL</option>
                            <option value="L">L</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-lg me-1"></i>Ajouter
                        </button>
                    </div>
                    <div id="ajout-erreur" class="col-12 text-danger small d-none"></div>
                </form>
            </div>
        </div>
    </div>
</main>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    window.LISTE_COURSE_ID = {{ liste.id }};
    window.URL_AJOUTER_MANUEL = '{{ path('app_liste_course_ajouter_manuel', {id: liste.id}) }}';
    window.URL_CHECK = '/liste-courses/check/';
</script>
<script src="{{ asset('js/courses/show.js') }}"></script>
{% endblock %}
