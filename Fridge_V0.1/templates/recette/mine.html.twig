{% extends 'base.html.twig' %}

{% block title %}Mes recettes - Fridge{% endblock %}

{% block body %}
<div class="search-hero mb-5">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
        <div>
            <h1 class="display-4 fw-bold mb-1" style="font-family: var(--font-display);">Mes Créations</h1>
            <p class="lead text-muted mb-0">Votre carnet de recettes personnel, visible uniquement par vous.</p>
        </div>
        <a href="{{ path('app_recette_new') }}" class="btn btn-primary btn-lg px-4 shadow-lg">
            <i class="bi bi-plus-lg me-2"></i> Nouvelle recette
        </a>
    </div>
</div>

<main class="container mb-5">
    {# --- Filtres régime --- #}
    <div class="d-flex flex-wrap gap-2 mb-5 justify-content-center">
        {% set regimes = ['all', 'Omnivore', 'Végétarien', 'Vegan', 'Sans gluten', 'Sans lactose'] %}
        {% for regime in regimes %}
            <a href="{{ path('app_recette_mine', {regime: regime, sort: activeSort}) }}"
               class="btn btn-outline-dark rounded-pill px-4"
               style="{{ activeRegime == regime ? 'background-color: var(--primary); border-color: var(--primary); color: var(--text);' : '' }}">
                {{ regime == 'all' ? 'Toutes mes recettes' : regime }}
            </a>
        {% endfor %}
    </div>

    {# --- Liste des recettes utilisateur --- #}
    {% if recettes is empty %}
        <div class="bento-grid text-center py-5">
            <i class="bi bi-journal-text display-1 text-muted opacity-25 mb-4"></i>
            <p class="text-muted h4 mb-4">Vous n'avez pas encore créé de recette.</p>
            <a href="{{ path('app_recette_new') }}" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-plus-lg me-2"></i> Créer ma première recette
            </a>
        </div>
    {% else %}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            {% for recette in recettes %}
                <div class="col">
                    {% include 'components/_recipe_card.html.twig' with {
                        title:      recette.recetteLibelle,
                        time:       (recette.recetteTempsPrepa ?? 0) + (recette.recetteTempsCuisson ?? 0),
                        id:         recette.id,
                        photo:      recette.recettePhoto,
                        description: recette.recetteDescription
                    } %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}