{% extends 'base.html.twig' %}

{% block title %}{{ meal.title }} - Fridge{% endblock %}

{% block body %}
<main class="container py-5">

    <nav aria-label="Fil d'ariane" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_recette_index') }}">Découvrir</a></li>
            <li class="breadcrumb-item active">{{ meal.title }}</li>
        </ol>
    </nav>

    <div class="row g-5">

        {# ── Colonne gauche : visuel + méta ── #}
        <div class="col-12 col-lg-5">

            <div style="border-radius:var(--radius-xl);overflow:hidden;box-shadow:var(--shadow-lg);">
                <img src="{{ meal.image }}" alt="{{ meal.title }}"
                     style="width:100%;aspect-ratio:1/1;object-fit:cover;">
            </div>

            {# Badges méta #}
            <div class="mt-4 d-flex flex-wrap gap-2">
                {% if meal.category %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:var(--primary-light);color:var(--primary);font-size:0.82rem;">
                        <i class="bi bi-tag me-1"></i>{{ meal.category }}
                    </span>
                {% endif %}
                {% if meal.area %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:var(--accent-light);color:var(--accent-dark);font-size:0.82rem;">
                        <i class="bi bi-geo-alt me-1"></i>{{ meal.area }}
                    </span>
                {% endif %}
                {% if meal.country and meal.country != meal.area %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:var(--surface-muted);color:var(--text-secondary);font-size:0.82rem;">
                        <i class="bi bi-globe me-1"></i>{{ meal.country }}
                    </span>
                {% endif %}
                {% for tag in meal.tags %}
                    <span class="badge rounded-pill px-3 py-2"
                          style="background:var(--surface-muted);color:var(--text-secondary);font-size:0.78rem;">
                        {{ tag }}
                    </span>
                {% endfor %}
            </div>

            {# Liens externes #}
            <div class="mt-4 d-flex flex-wrap gap-2">
                {% if meal.youtube %}
                    <a href="{{ meal.youtube }}" target="_blank" rel="noopener"
                       class="btn btn-outline-danger rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-youtube"></i> Voir la vidéo
                    </a>
                {% endif %}
                {% if meal.source %}
                    <a href="{{ meal.source }}" target="_blank" rel="noopener"
                       class="btn btn-outline-secondary rounded-pill d-inline-flex align-items-center gap-2">
                        <i class="bi bi-link-45deg"></i> Source originale
                    </a>
                {% endif %}
            </div>

            {% if meal.dateModified %}
                <p class="mt-3" style="font-size:0.75rem;color:var(--text-muted);">
                    Mise à jour : {{ meal.dateModified|date('d/m/Y') }}
                </p>
            {% endif %}
        </div>

        {# ── Colonne droite : titre + ingrédients + instructions ── #}
        <div class="col-12 col-lg-7">

            <h1 class="fw-bold mb-2" style="font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.4rem);">
                {{ meal.title }}
            </h1>
            {% if meal.titleAlt %}
                <p class="mb-4" style="color:var(--text-secondary);font-style:italic;">{{ meal.titleAlt }}</p>
            {% endif %}

            {# Ingrédients #}
            {% if meal.ingredients %}
                <section class="mb-5 p-4 rounded-4" style="background:var(--surface-muted);">
                    <h2 class="h5 fw-bold mb-3" style="font-family:var(--font-display);">
                        <i class="bi bi-basket2 me-2" style="color:var(--primary);"></i>
                        Ingrédients
                        <span class="ms-2 badge rounded-pill"
                              style="background:var(--primary);color:#fff;font-size:0.75rem;">
                            {{ meal.ingredients|length }}
                        </span>
                    </h2>
                    <ul class="list-unstyled row row-cols-1 row-cols-sm-2 g-2 mb-0">
                        {% for ingredient in meal.ingredients %}
                            <li class="col d-flex align-items-start gap-2">
                                <span class="mt-1 flex-shrink-0"
                                      style="width:7px;height:7px;border-radius:50%;background:var(--primary);display:inline-block;"></span>
                                <span class="small">
                                    {% if ingredient.measure %}
                                        <strong>{{ ingredient.measure }}</strong>
                                    {% endif %}
                                    {{ ingredient.name }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {# Instructions #}
            {% if meal.instructions %}
                <section>
                    <h2 class="h5 fw-bold mb-3" style="font-family:var(--font-display);">
                        <i class="bi bi-list-ol me-2" style="color:var(--primary);"></i>Préparation
                    </h2>
                    {# Découpe les instructions en étapes numérotées (séparées par \r\n\r\n ou \n\n) #}
                    {% set steps = meal.instructions|split('\r\n\r\n') %}
                    {% if steps|length <= 1 %}
                        {% set steps = meal.instructions|split('\n\n') %}
                    {% endif %}

                    {% if steps|length > 1 %}
                        <ol class="d-flex flex-column gap-3 ps-0" style="list-style:none;">
                            {% for step in steps %}
                                {% if step|trim %}
                                    <li class="d-flex gap-3 align-items-start">
                                        <span class="fw-bold flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle"
                                              style="width:28px;height:28px;min-width:28px;background:var(--primary-light);color:var(--primary);font-size:0.8rem;margin-top:2px;">
                                            {{ loop.index }}
                                        </span>
                                        <p class="mb-0 small" style="color:var(--text-secondary);line-height:1.8;">
                                            {{ step|trim }}
                                        </p>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ol>
                    {% else %}
                        <p class="small" style="color:var(--text-secondary);line-height:1.9;white-space:pre-line;">
                            {{ meal.instructions }}
                        </p>
                    {% endif %}
                </section>
            {% endif %}

        </div>
    </div>
</main>
{% endblock %}
