{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Fridge{% endblock %}

{% block body %}
    <main class="container py-4">

        {# 2. FIL D'ARIANE #}
        <nav aria-label="Fil d'ariane">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('app_home') }}"><i class="bi bi-house me-1"></i>Accueil</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Mon Profil</li>
            </ol>
        </nav>

        {# 3. CARTE UTILISATEUR #}
        <section id="user" class="bg-white shadow-sm rounded-3 p-4 mb-4">
            <div class="row align-items-center text-center text-md-start">

                <div class="col-8 col-md-3 col-lg-2 mx-auto mb-3 mb-md-0">
                    <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150"
                         alt="Photo de profil"
                         class="img-fluid rounded-circle border border-4 border-light shadow-sm">
                </div>

                <div class="col-12 col-md-9 col-lg-10">
                    <h1 class="h2 fw-bold mb-1">
                        {{ app.user.strFirstname }} {{ app.user.strName }}
                    </h1>
                    <p class="text-muted mb-1 small">@{{ app.user.strUsername }}</p>
                    <p class="text-muted mb-3 small fst-italic">"Cuisiner est un art, mais manger est un plaisir."</p>

                    <div class="mt-3 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                        <a href="{{ path('app_edit_user_profil') }}" class="btn btn-sm btn-outline-dark">
                            <i class="bi bi-gear me-1"></i> Paramètres
                        </a>
                        <a href="{{ path('app_user_profil_by_id', {user_id: app.user.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-person-lines-fill me-1"></i> Voir mon profil public
                        </a>
                    </div>
                </div>

            </div>
        </section>

        {# 4. MES LIKES #}
        <section class="bg-white shadow-sm rounded-3 p-4 mb-4">
            <h2 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-heart-fill text-danger"></i> Mes Likes
            </h2>

            
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                {% for item in arrLikes %}
                    <div class="col">
                    {% include 'components/_recipe_card.html.twig' with {
                        title:      item.recette.recetteLibelle,
                        time:       item.recette.recetteTempsPrepa + item.recette.recetteTempsCuisson,
                        id:         item.recette.id,
                        photo:      item.recette.recettePhoto,
                        like_count: item.likeCount,
                        is_liked:   true
                    } %}
                    </div>
                {% else %}
                    <p class="text-muted small">Vous n'avez pas encore liké de recettes.</p>
                {% endfor %}
            </div>
        </section>

        {# 5. MES LISTES #}
        <section class="bg-white shadow-sm rounded-3 p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h2 class="h5 fw-bold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-collection-fill text-primary"></i> Mes Listes
                </h2>
                {% if arrListes|length > 3 %}
                    <a href="{{ path('app_liste_index') }}" class="btn btn-sm btn-outline-secondary">
                        Voir toutes les listes <span class="badge bg-secondary ms-1">{{ arrListes|length }}</span>
                    </a>
                {% endif %}
            </div>

            {% if arrListes is empty %}
                <p class="text-muted small">Vous n'avez pas encore créé de liste.<br>
                    Ouvrez une recette et cliquez sur <i class="bi bi-bookmark"></i> pour en créer une.
                </p>
            {% else %}
                <div class="row g-3">
                    {% for liste in arrListes|slice(0, 3) %}
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="fw-semibold small">
                                        <i class="bi bi-collection-fill text-primary me-1"></i>{{ liste.nom }}
                                    </span>
                                    <span class="badge rounded-pill bg-light text-dark border small">
                                        {{ liste.recettes|length }}
                                    </span>
                                </div>
                                {% if liste.recettes is not empty %}
                                    <ul class="list-unstyled mb-0">
                                        {% for recette in liste.recettes|slice(0, 3) %}
                                            <li class="small text-muted text-truncate py-1 border-bottom">
                                                <a href="{{ path('app_recette_show', {id: recette.id}) }}"
                                                   class="text-decoration-none text-muted">
                                                    {{ recette.recetteLibelle }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                        {% if liste.recettes|length > 3 %}
                                            <li class="small text-muted pt-1">+ {{ liste.recettes|length - 3 }} autre{{ liste.recettes|length - 3 > 1 ? 's' : '' }}…</li>
                                        {% endif %}
                                    </ul>
                                {% else %}
                                    <p class="text-muted small mb-0">Liste vide</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if arrListes|length > 3 %}
                    <div class="text-center mt-3">
                        <a href="{{ path('app_liste_index') }}" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-collection me-1"></i>Voir toutes mes listes ({{ arrListes|length }})
                        </a>
                    </div>
                {% endif %}
            {% endif %}
        </section>

    </main>

{% endblock %}