<footer class="mt-auto" style="background:var(--surface-muted);border-top:1px solid var(--border-light);">
    <div class="container py-5">

        <div class="row gy-4 gx-5">

            <!-- Branding -->
            <div class="col-12 col-md-4">
                <a href="{{ path('app_home') }}" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-3">
                    <div style="width:34px;height:34px;background:var(--primary);border-radius:10px;display:flex;align-items:center;justify-content:center;">
                        <img src="{{ asset('img/fridge_favicon_nobg.png') }}" width="22" height="22" alt="Logo" style="filter:brightness(10);">
                    </div>
                    <span style="font-family:var(--font-display);font-weight:800;font-size:1.15rem;color:var(--text);letter-spacing:-0.03em;">Fridge</span>
                </a>
                <p class="small mb-0" style="color:var(--text-secondary);max-width:260px;line-height:1.6;">
                    Planifiez vos repas, cuisinez avec plaisir et réduisez le gaspillage.
                </p>
            </div>

            <!-- Navigation -->
            <div class="col-6 col-md-2">
                <p class="fw-700 mb-3" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--text);">Explorer</p>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="{{ path('app_home') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Accueil</a></li>
                    <li><a href="{{ path('app_recette_index') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Découvrir</a></li>
                    {% if app.user %}
                        <li><a href="{{ path('app_planning') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Mon Planning</a></li>
                        <li><a href="{{ path('app_stock') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Mon Frigo</a></li>
                        <li><a href="{{ path('app_liste_course_index') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Mes Courses</a></li>
                    {% endif %}
                </ul>
            </div>

            <!-- Compte -->
            <div class="col-6 col-md-2">
                <p class="fw-700 mb-3" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--text);">Compte</p>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    {% if app.user %}
                        <li><a href="{{ path('app_user_profil') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Mon profil</a></li>
                        <li><a href="{{ path('app_logout') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Connexion</a></li>
                        <li><a href="{{ path('app_register') }}" class="small text-decoration-none" style="color:var(--text-secondary);">Créer un compte</a></li>
                    {% endif %}
                </ul>
            </div>

            <!-- Suivre -->
            <div class="col-12 col-md-4">
                <p class="fw-700 mb-3" style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--text);">Nous suivre</p>
                <div class="d-flex gap-2 flex-wrap">
                    {% for social in [
                        {name: 'Instagram', icon: 'bi-instagram'},
                        {name: 'TikTok',    icon: 'bi-tiktok'},
                        {name: 'LinkedIn',  icon: 'bi-linkedin'}
                    ] %}
                        <a href="#"
                           aria-label="{{ social.name }}"
                           class="d-inline-flex align-items-center justify-content-center text-decoration-none transition"
                           style="width:38px;height:38px;border-radius:10px;background:var(--surface);border:1px solid var(--border);color:var(--text-secondary);">
                            <i class="bi {{ social.icon }}" style="font-size:1rem;"></i>
                        </a>
                    {% endfor %}
                </div>
            </div>

        </div>

        <!-- Séparateur -->
        <hr class="my-4" style="border-color:var(--border);">

        <!-- Bas -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <p class="mb-0 small" style="color:var(--text-muted);">© 2026 Fridge — Tous droits réservés</p>
            <a href="#mainNav" class="small text-decoration-none d-flex align-items-center gap-1 transition"
               style="color:var(--text-muted);">
                Haut de page <i class="bi bi-arrow-up"></i>
            </a>
        </div>

    </div>
</footer>
