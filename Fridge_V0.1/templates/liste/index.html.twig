{% extends 'base.html.twig' %}
{% block title %}Mes Listes - Fridge{% endblock %}

{% block body %}
<div class="search-hero mb-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="display-5 fw-bold mb-1">Mes Listes</h1>
                <p class="text-muted mb-0">{{ listes|length }} liste{{ listes|length > 1 ? 's' : '' }}</p>
            </div>
            <a href="{{ path('app_user_profil') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Retour au profil
            </a>
        </div>
    </div>
</div>

<main class="container mb-5">
    {% if listes is empty %}
        <div class="text-center py-5">
            <i class="bi bi-collection display-1 text-muted"></i>
            <p class="text-muted mt-3">Vous n'avez pas encore créé de liste.<br>Ouvrez une recette et cliquez sur <i class="bi bi-bookmark"></i> pour commencer.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for liste in listes %}
                <div class="col-md-6 col-lg-4">
                    <div class="bento-grid p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="h5 fw-bold mb-0" style="font-family: var(--font-display);">
                                <i class="bi bi-collection-fill text-primary me-2"></i>{{ liste.nom }}
                            </h2>
                            <span class="badge rounded-pill" style="background-color: var(--primary-light); color: var(--text);">
                                {{ liste.recettes|length }} recette{{ liste.recettes|length > 1 ? 's' : '' }}
                            </span>
                        </div>

                        {% if liste.recettes is empty %}
                            <p class="text-muted small">Aucune recette dans cette liste.</p>
                        {% else %}
                            <ul class="list-group list-group-flush mb-3">
                                {% for recette in liste.recettes|slice(0, 4) %}
                                    <li class="list-group-item px-0 py-2 bg-transparent border-bottom d-flex align-items-center gap-2">
                                        {% if recette.recettePhoto %}
                                            <img src="{{ recette.recettePhoto|recette_photo }}"
                                                 alt="{{ recette.recetteLibelle }}"
                                                 class="rounded flex-shrink-0"
                                                 style="width:40px;height:40px;object-fit:cover;">
                                        {% else %}
                                            <div class="rounded bg-secondary-subtle flex-shrink-0" style="width:40px;height:40px;"></div>
                                        {% endif %}
                                        <a href="{{ path('app_recette_show', {id: recette.id}) }}"
                                           class="text-decoration-none text-dark small fw-medium text-truncate">
                                            {{ recette.recetteLibelle }}
                                        </a>
                                    </li>
                                {% endfor %}
                                {% if liste.recettes|length > 4 %}
                                    <li class="list-group-item px-0 py-2 bg-transparent text-muted small">
                                        + {{ liste.recettes|length - 4 }} autre{{ liste.recettes|length - 4 > 1 ? 's' : '' }}…
                                    </li>
                                {% endif %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</main>
{% endblock %}
