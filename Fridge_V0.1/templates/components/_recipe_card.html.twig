{# templates/components/_recipe_card.html.twig #}
<div class="card h-100 border-0 bg-transparent group"
     {% if is_granted('ROLE_USER') and id is defined %}
         data-controller="recipe-actions"
         data-like-url="{{ path('app_like_toggle', {id: id}) }}"
         data-favori-url="{{ path('app_favori_toggle', {id: id}) }}"
         data-recipe-actions-liked-value="{{ is_liked|default(false) ? 'true' : 'false' }}"
         data-recipe-actions-favori-value="{{ is_favori|default(false) ? 'true' : 'false' }}"
     {% endif %}
>
    <div class="position-relative overflow-hidden mb-3" style="border-radius: var(--radius-lg);">
        {% if photo|default('') %}
            <img src="{{ photo|recette_photo }}"
                 class="w-100 transition-normal group-hover-scale" alt="{{ title }}"
                 style="height: 280px; object-fit: cover;">
        {% else %}
            {% set _regime = regime|default('') %}
            {% if _regime == 'Végétarien' or _regime == 'Vegan' %}
                {% set _emoji = '🥗' %}
                {% set _bg = 'linear-gradient(135deg, #d4edda 0%, #a8d5b5 100%)' %}
            {% elseif _regime == 'Péscitarien' %}
                {% set _emoji = '🐟' %}
                {% set _bg = 'linear-gradient(135deg, #cfe2ff 0%, #9ec5fe 100%)' %}
            {% else %}
                {% set _emoji = '🍽️' %}
                {% set _bg = 'linear-gradient(135deg, var(--primary-light) 0%, #fdd5c2 100%)' %}
            {% endif %}
            <div class="w-100 d-flex align-items-center justify-content-center"
                 style="height: 280px; background: {{ _bg }}; font-size: 5rem;">
                {{ _emoji }}
            </div>
        {% endif %}

        {# Badge EN pour les recettes TheMealDB #}
        {% if is_mealdb|default(false) or mealdb_id|default(false) %}
            <div class="position-absolute top-0 start-0 m-2">
                <span class="badge bg-dark opacity-75 px-2 py-1" style="font-size: 0.65rem;">🌍 EN</span>
            </div>
        {% endif %}

        {# Actions overlay #}
        {% if is_granted('ROLE_USER') and id is defined %}
            <div class="position-absolute top-0 end-0 m-3 d-flex flex-column gap-2 translate-middle-x opacity-0 group-hover-opacity-100 transition-normal" style="transform: translateX(20px);">
                <button class="btn btn-white rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                        style="width: 30px; height: 30px; border: none;"
                        data-action="recipe-actions#toggleLike">
                    <i data-recipe-actions-target="likeIcon"
                       class="bi {{ is_liked|default(false) ? 'bi-heart-fill text-danger' : 'bi-heart text-muted' }}"></i>
                </button>

                <button class="btn btn-white rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                        style="width: 30px; height: 30px; border: none;"
                        data-action="recipe-actions#toggleFavori">
                    <i data-recipe-actions-target="favoriIcon"
                    class="bi {{ is_favori|default(false) ? 'bi-bookmark-fill text-warning' : 'bi-bookmark text-muted' }}"></i>
                </button>
            </div>
        {% endif %}

        <div class="position-absolute bottom-0 start-0 m-3">
            <span class="badge rounded-pill bg-white text-dark shadow-sm px-3 py-2">
                <i class="bi bi-clock-fill text-primary me-2"></i> {{ time|default('15') }} min
            </span>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h3 class="h4 fw-bold mb-0 text-dark group-hover-text-primary transition-fast" style="font-family: var(--font-display);">
                {% if id is defined %}
                    <a href="{{ path('app_recette_show', {id: id}) }}" class="text-decoration-none text-inherit">
                        {{ title }}
                    </a>
                {% else %}
                    {{ title }}
                {% endif %}
            </h3>
            {% if like_count|default(0) > 0 %}
                <span class="small text-muted" data-recipe-actions-target="likeCount">
                    {{ like_count }} <i class="bi bi-heart-fill text-danger ms-1" style="font-size: 0.7rem;"></i>
                </span>
            {% endif %}
        </div>
        
        <p class="text-muted small mb-0 line-clamp-2">
            {{ description|default('Une recette savoureuse et équilibrée pour égayer vos papilles.') }}
        </p>
    </div>
</div>

<style>
.group:hover .group-hover-scale {
    transform: scale(1.05);
}
.group-hover-opacity-100 {
    opacity: 1 !important;
    transform: translateX(0) !important;
}
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

@media (max-width: 768px) {
  .group-hover-opacity-100 {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }
}
</style>